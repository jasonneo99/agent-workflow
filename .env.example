# Model Provider — choose one: mock, byo, openai, bedrock, openai-compatible, kiro
DEFAULT_MODEL_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AWS Bedrock
BEDROCK_MODEL=amazon.nova-pro-v1:0
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0
BEDROCK_MODEL_STANDARD=amazon.nova-pro-v1:0
BEDROCK_MODEL_REASONING=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=

# BYO Model Gateway (recommended neutral path)
BYO_MODEL_BASE_URL=http://localhost:11434/v1
BYO_MODEL_API_KEY=
BYO_MODEL_NAME=

# OpenAI-Compatible (Ollama, LM Studio, vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Kiro CLI
KIRO_CLI_BIN=kiro-cli
KIRO_API_KEY=
KIRO_AGENT=
KIRO_TIMEOUT_MS=600000

# Enterprise Storage (only needed with docker compose)
DATABASE_URL=postgres://agentflow:agentflow@localhost:15432/agentflow
REDIS_URL=redis://localhost:16379
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_BUCKET=agentflow-artifacts
OBJECT_STORAGE_ACCESS_KEY=agentflow
OBJECT_STORAGE_SECRET_KEY=agentflow-secret

# Workflow defaults
DEFAULT_AUTONOMY=2
