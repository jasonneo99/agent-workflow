{
  "name": "@jasonneo99/agent-workflow",
  "version": "0.4.12",
  "type": "module",
  "description": "Portable, model-agnostic agent workflows for any codebase",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "workflows",
    "llm",
    "bedrock",
    "gemini",
    "openai",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonneo99/agent-workflow.git"
  },
  "bin": {
    "agentflow": "dist/apps/cli/src/index.js",
    "agentflow-mcp": "dist/apps/mcp/src/index.js",
    "agentflow-setup": "dist/apps/cli/src/setup.js",
    "agentflow-model-gateway": "dist/apps/gateway/src/index.js",
    "agentflow-reliability": "dist/apps/cli/src/reliability-command.js",
    "agentflow-release": "scripts/atomic-release.mjs"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "agents/",
    "workflows/",
    "policies/",
    "evals/",
    "templates/template-manifest.json",
    "templates/project/AGENTS.md",
    "templates/project/package.json",
    "templates/project/.agent-workflow/agents/project-reviewer.yaml",
    "templates/project/.agent-workflow/bundle-state.json",
    "templates/project/.agent-workflow/commands.md",
    "templates/project/.agent-workflow/context.md",
    "templates/project/.agent-workflow/decisions.md",
    "templates/project/.agent-workflow/evaluation-gates.yaml",
    "templates/project/.agent-workflow/evaluations/daemon-model-comparison-standard.yaml",
    "templates/project/.agent-workflow/project.yaml",
    "templates/project/.agent-workflow/schedules.yaml",
    "templates/project-simple/AGENTS.md",
    "templates/project-simple/.agent-workflow/agents/project-reviewer.yaml",
    "templates/project-simple/.agent-workflow/bundle-state.json",
    "templates/project-simple/.agent-workflow/commands.md",
    "templates/project-simple/.agent-workflow/context.md",
    "templates/project-simple/.agent-workflow/decisions.md",
    "templates/project-simple/.agent-workflow/project.yaml",
    "templates/project-simple/.agent-workflow/schedules.yaml",
    "templates/provider-smoke/AGENTS.md",
    "templates/provider-smoke/.agent-workflow/commands.md",
    "templates/provider-smoke/.agent-workflow/context.md",
    "templates/provider-smoke/.agent-workflow/decisions.md",
    "templates/provider-smoke/.agent-workflow/evaluations/daemon-model-comparison-fast.yaml",
    "templates/provider-smoke/.agent-workflow/evaluations/daemon-model-comparison-standard.yaml",
    "templates/provider-smoke/.agent-workflow/project.yaml",
    "docs/",
    "schemas/",
    "registries/",
    "migrations/",
    "scripts/capture-dashboard-screenshots.mjs",
    "scripts/agentflow.mjs",
    "scripts/dev-agentflow.mjs",
    "scripts/dev-agentflow-stop.mjs",
    "scripts/install-launchagent.mjs",
    "scripts/local-model-runtime.mjs",
    "scripts/run-local-model-runtime.sh",
    "scripts/run-agent-workflow-supervisor.sh",
    "scripts/provider-smoke.sh",
    "scripts/run-agent-workflow-mcp.sh",
    "scripts/uninstall-launchagent.mjs",
    "scripts/atomic-release.mjs",
    "scripts/notify-requester.py",
    "agent-workflow.bundle.json",
    "repository-maintenance-baseline.json",
    ".env.example",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "tsx apps/cli/src/setup.ts",
    "build": "tsc",
    "check": "npm run validate && npm run validate-boundary && npm run validate-examples && npm run repository-maintenance -- -p . --check && npm run typecheck && npm test",
    "canary:dynamic": "DEFAULT_MODEL_PROVIDER=mock node scripts/agentflow.mjs dynamic-plan --project templates/project --task 'Create me a local web app that tracks release readiness' --json",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/verify-publish-boundary.mjs && npm run validate-boundary && npm run pack:check",
    "pack:check": "node scripts/verify-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:atomic": "node scripts/atomic-release.mjs",
    "screenshots:dashboard": "node scripts/capture-dashboard-screenshots.mjs",
    "dashboard:sla": "node scripts/dashboard-sla-canary.mjs",
    "dashboard:characterize": "node --import tsx scripts/dashboard-characterization.ts",
    "runtime:verify-live": "node scripts/verify-live-runtime.mjs",
    "performance:baseline": "tsx scripts/performance-baseline.ts",
    "performance:compare": "tsx scripts/performance-compare.ts",
    "performance:workflow-compare": "tsx scripts/workflow-speed-compare.ts",
    "agentflow": "tsx apps/cli/src/index.ts",
    "artifacts": "node scripts/agentflow.mjs artifacts",
    "accepted-outcomes": "node scripts/agentflow.mjs accepted-outcomes",
    "backup-report": "node scripts/agentflow.mjs backup-report",
    "compile": "node scripts/agentflow.mjs compile",
    "context-report": "node scripts/agentflow.mjs context-report",
    "context-status": "node scripts/agentflow.mjs context-status",
    "context-calibrate": "node scripts/agentflow.mjs context-calibrate",
    "context-thresholds": "node scripts/agentflow.mjs context-thresholds",
    "context-route": "node scripts/agentflow.mjs context-route",
    "context-holdout": "node scripts/agentflow.mjs context-holdout",
    "context-promote": "node scripts/agentflow.mjs context-promote",
    "context-host-setup": "node scripts/agentflow.mjs context-host-setup",
    "context-host-doctor": "node scripts/agentflow.mjs context-host-doctor",
    "context-codegen": "node scripts/agentflow.mjs context-codegen",
    "client-capabilities": "node scripts/agentflow.mjs client-capabilities --json",
    "dashboard": "tsx apps/cli/src/index.ts dashboard",
    "model-gateway": "tsx apps/gateway/src/index.ts serve",
    "model-gateway:report": "tsx apps/gateway/src/index.ts report",
    "model-gateway:import": "tsx apps/gateway/src/index.ts import",
    "dev:agentflow": "node scripts/dev-agentflow.mjs",
    "dev:agentflow:stop": "node scripts/dev-agentflow-stop.mjs",
    "dev:agentflow:launchd:install": "node scripts/install-launchagent.mjs",
    "dev:agentflow:launchd:uninstall": "node scripts/uninstall-launchagent.mjs",
    "local-model:status": "node scripts/local-model-runtime.mjs status",
    "local-model:launchd:install": "node scripts/local-model-runtime.mjs install",
    "local-model:launchd:uninstall": "node scripts/local-model-runtime.mjs uninstall",
    "bootstrap-storage": "node scripts/agentflow.mjs bootstrap-storage",
    "bundle-registry": "node scripts/agentflow.mjs bundle-registry",
    "bundle-pin": "node scripts/agentflow.mjs bundle-pin",
    "bundle-lifecycle-plan": "node scripts/agentflow.mjs bundle-lifecycle-plan",
    "bundle-manifest": "node scripts/agentflow.mjs bundle-manifest",
    "doctor": "node scripts/agentflow.mjs doctor",
    "exec-command": "node scripts/agentflow.mjs exec-command",
