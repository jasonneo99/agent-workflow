    "local-llm-smoke": "node scripts/agentflow.mjs local-llm-smoke",
    "local-holdout-comparison": "node scripts/agentflow.mjs local-holdout-comparison",
    "local-holdout-promote": "node scripts/agentflow.mjs local-holdout-promote",
    "local-holdout-results": "node scripts/agentflow.mjs local-holdout-results",
    "migrate-storage": "node scripts/agentflow.mjs migrate-storage",
    "onboard-project": "node scripts/agentflow.mjs onboard-project",
    "validate": "node scripts/agentflow.mjs validate",
    "validate-examples": "node scripts/validate-scrubbed-examples.mjs",
    "validate-boundary": "node scripts/validate-open-source-boundary.mjs",
    "list": "node scripts/agentflow.mjs list",
    "mcp": "tsx apps/mcp/src/index.ts",
    "object-artifact-proof": "node scripts/agentflow.mjs object-artifact-proof",
    "offline-fallback": "node scripts/agentflow.mjs offline-fallback",
    "offline-sync": "node scripts/agentflow.mjs offline-sync",
    "provider-check": "node scripts/agentflow.mjs provider-check",
    "provider-smoke": "bash scripts/provider-smoke.sh",
    "project-files": "node scripts/agentflow.mjs project-files",
    "reset-storage": "node scripts/agentflow.mjs reset-storage --yes",
    "restore-drill": "node scripts/agentflow.mjs restore-drill",
    "roadmap-audit": "node scripts/agentflow.mjs roadmap-audit",
    "repository-maintenance": "node scripts/agentflow.mjs repository-maintenance",
    "reuse-plan": "node scripts/agentflow.mjs reuse-plan",
    "reliability-baseline": "tsx scripts/reliability-baseline.ts",
    "reliability:gate": "tsx scripts/reliability-gate.ts",
    "runtime-monitor": "tsx apps/cli/src/index.ts runtime-monitor",
    "reliability": "node dist/apps/cli/src/reliability-command.js",
