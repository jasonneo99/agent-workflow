    "test": "node --import tsx scripts/test-isolated.ts",
    "smoke": "bash scripts/smoke-enterprise.sh",
    "services:reset": "docker compose -f infra/docker-compose.yml down -v",
    "server-readiness": "node scripts/agentflow.mjs server-readiness",
    "server-approval-action": "node scripts/agentflow.mjs server-approval-action",
    "server-approval-action-plan": "node scripts/agentflow.mjs server-approval-action-plan",
    "server-approval-action-test-adapter": "node scripts/agentflow.mjs server-approval-action-test-adapter",
    "server-mutation-controls": "node scripts/agentflow.mjs server-mutation-controls",
    "server-projects": "node scripts/agentflow.mjs server-projects",
    "server-resolve-project": "node scripts/agentflow.mjs server-resolve-project",
    "server-request-preview": "node scripts/agentflow.mjs server-request-preview",
    "server-route-preview": "node scripts/agentflow.mjs server-route-preview",
    "server-approval-preview": "node scripts/agentflow.mjs server-approval-preview",
    "worker": "tsx apps/cli/src/index.ts worker",
    "worker:daemon": "tsx apps/cli/src/index.ts worker --watch --limit 6 --interval-ms 2000",
    "worker:watch": "tsx apps/cli/src/index.ts worker --watch --limit 1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1098.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0",
