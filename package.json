    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "glob": "^13.0.6",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "redis": "^5.12.1",
    "typescript": "^5.6.2",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
