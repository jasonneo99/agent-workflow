# Model Provider — choose one: mock, local, byo, openai, bedrock, openai-compatible, kiro
DEFAULT_MODEL_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
# Use auto to select tier models from the live OpenAI /v1/models catalog.
# Pin exact model ids only when you need reproducible runs.
OPENAI_MODEL=auto
OPENAI_MODEL_FAST=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_REASONING=

# AWS Bedrock
BEDROCK_MODEL=auto
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_STANDARD=
BEDROCK_MODEL_REASONING=
AWS_REGION=us-east-1
AWS_PROFILE=

# Local Model Runtime (Ollama, LM Studio, llama.cpp-compatible endpoints)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_NAME=auto
LOCAL_MODEL_FAST=
LOCAL_MODEL_STANDARD=
LOCAL_MODEL_REASONING=

# BYO Model Gateway (remote or enterprise OpenAI-compatible path)
BYO_MODEL_BASE_URL=http://localhost:11434/v1
BYO_MODEL_API_KEY=
BYO_MODEL_NAME=auto
BYO_MODEL_FAST=
BYO_MODEL_STANDARD=
BYO_MODEL_REASONING=

# OpenAI-Compatible (Ollama, LM Studio, vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=auto

# Kiro CLI
KIRO_CLI_BIN=kiro-cli
KIRO_API_KEY=
KIRO_AGENT=
KIRO_TIMEOUT_MS=600000

# Enterprise Storage (only needed with docker compose)
# Optional shared state-plane host. Prefer a Tailscale MagicDNS name or IP that
# reaches Postgres, Redis, and MinIO; explicit service URLs below still win.
AGENTFLOW_SHARED_STORAGE_HOST=
DATABASE_URL=postgres://agentflow:agentflow@localhost:15432/agentflow
REDIS_URL=redis://localhost:16379
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_BUCKET=agentflow-artifacts
OBJECT_STORAGE_ACCESS_KEY=agentflow
OBJECT_STORAGE_SECRET_KEY=agentflow-secret

# Workflow defaults
DEFAULT_AUTONOMY=2

# Governed server mode (future opt-in shared runtime; local-first is default)
AGENTFLOW_SERVER_MODE=0
AGENTFLOW_SERVER_BIND=127.0.0.1
AGENTFLOW_SERVER_PORT=17888
AGENTFLOW_SERVER_AUTH=none
AGENTFLOW_SERVER_TOKEN=
AGENTFLOW_SERVER_ALLOWED_ORIGINS=http://127.0.0.1:17888
AGENTFLOW_SERVER_MAX_BODY_BYTES=64000
AGENTFLOW_SERVER_RATE_LIMIT_PER_MINUTE=60
# Optional override. Defaults to .agent-workflow/runtime/server/request-log.jsonl.
AGENTFLOW_SERVER_REQUEST_LOG=

# Adaptive routing and quality scoring
AGENTFLOW_ROUTING_MODE=adaptive
AGENTFLOW_PROVIDER_FAST=
AGENTFLOW_PROVIDER_STANDARD=
AGENTFLOW_PROVIDER_REASONING=
AGENTFLOW_FALLBACK_PROVIDER=
AGENTFLOW_AUTO_PROVIDERS=local,byo,bedrock,openai,openai-compatible,kiro
AGENTFLOW_QUALITY_THRESHOLD=0.62
# lowest-cost, balanced, best-coding, or maximum-reasoning
AGENTFLOW_MODEL_POLICY=best-coding
# Enable daemon approval autopilot only when you want local low/medium approvals drained automatically.
AGENTFLOW_APPROVAL_AUTOPILOT=off
# low, medium, or high; medium auto-approves and executes policy-allowed low/medium local side effects when autopilot is on
AGENTFLOW_APPROVAL_AUTOPILOT_MAX_RISK=medium
# Daemon stale MCP cleanup is preview-only unless explicitly enabled.
AGENTFLOW_DAEMON_CLEANUP_STALE_MCP=off
# preview or auto-low-risk. auto-low-risk preserves the newest MCP session and only terminates old duplicate sessions.
AGENTFLOW_MCP_CLEANUP_MODE=preview
AGENTFLOW_MCP_STALE_MINUTES=60
# Off by default for public installs. Set to 1 on an operator-owned machine to let the daemon execute insert-only offline sync when both local fallback and shared storage are reachable.
AGENTFLOW_OFFLINE_SYNC_AUTO_EXECUTE=0

# Dev supervisor storage startup. Auto starts local Docker storage only when configured storage URLs are localhost.
# Set to 1 to force local fallback storage on, or 0 to force it off.
AGENTFLOW_START_LOCAL_STORAGE=auto

# Shared-storage project roots may be recorded by another host. Use this when a
# Linux worker path needs to resolve to this machine's local checkout for
# policy checks and local filesystem actions.
AGENTFLOW_PROJECT_PATH_MAP=/home/jasonmiller/Projects=/Users/jasonmiller/Projects
