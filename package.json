    "training-discovery": "node scripts/agentflow.mjs training-discovery",
    "apply-local-llm-routing-note-plan": "node scripts/agentflow.mjs apply-local-llm-routing-note-plan",
    "local-llm-benchmarks": "node scripts/agentflow.mjs local-llm-benchmarks",
    "local-llm-cache-trends": "node scripts/agentflow.mjs local-llm-cache-trends",
    "local-llm-checklist": "node scripts/agentflow.mjs local-llm-checklist",
    "local-llm-cost-ledger": "node scripts/agentflow.mjs local-llm-cost-ledger",
    "local-llm-download-recommendations": "node scripts/agentflow.mjs local-llm-download-recommendations",
    "local-llm-install-plan": "node scripts/agentflow.mjs local-llm-install-plan",
    "local-llm-inventory": "node scripts/agentflow.mjs local-llm-inventory",
