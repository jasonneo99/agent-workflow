{
  "name": "@jasonneo99/agent-workflow",
  "version": "0.2.6",
  "type": "module",
  "description": "Portable, model-agnostic agent workflows for any codebase",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "workflows",
    "llm",
    "bedrock",
    "openai",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonneo99/agent-workflow.git"
  },
  "bin": {
    "agentflow": "dist/apps/cli/src/index.js",
    "agentflow-mcp": "dist/apps/mcp/src/index.js",
    "agentflow-setup": "dist/apps/cli/src/setup.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "agents/",
    "workflows/",
    "templates/",
    "docs/",
    "schemas/",
    "registries/",
    "migrations/",
    "scripts/capture-dashboard-screenshots.mjs",
    "scripts/dev-agentflow.mjs",
    "scripts/dev-agentflow-stop.mjs",
    "scripts/install-launchagent.mjs",
    "scripts/local-model-runtime.mjs",
    "scripts/run-local-model-runtime.sh",
    "scripts/run-agent-workflow-supervisor.sh",
    "scripts/provider-smoke.sh",
    "scripts/run-agent-workflow-mcp.sh",
    "scripts/uninstall-launchagent.mjs",
    "agent-workflow.bundle.json",
    ".env.example",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "tsx apps/cli/src/setup.ts",
    "build": "tsc",
    "check": "npm run validate && npm run validate-examples && npm run typecheck && npm test",
    "canary:dynamic": "DEFAULT_MODEL_PROVIDER=mock tsx apps/cli/src/index.ts dynamic-plan --project templates/project --task 'Create me a local web app that tracks release readiness' --json",
    "prepack": "npm run build",
    "pack:check": "node scripts/verify-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "screenshots:dashboard": "node scripts/capture-dashboard-screenshots.mjs",
    "agentflow": "tsx apps/cli/src/index.ts",
    "artifacts": "tsx apps/cli/src/index.ts artifacts",
    "backup-report": "tsx apps/cli/src/index.ts backup-report",
    "compile": "tsx apps/cli/src/index.ts compile",
    "dashboard": "tsx apps/cli/src/index.ts dashboard",
    "dev:agentflow": "node scripts/dev-agentflow.mjs",
    "dev:agentflow:stop": "node scripts/dev-agentflow-stop.mjs",
    "dev:agentflow:launchd:install": "node scripts/install-launchagent.mjs",
    "dev:agentflow:launchd:uninstall": "node scripts/uninstall-launchagent.mjs",
    "local-model:status": "node scripts/local-model-runtime.mjs status",
    "local-model:launchd:install": "node scripts/local-model-runtime.mjs install",
    "local-model:launchd:uninstall": "node scripts/local-model-runtime.mjs uninstall",
    "bootstrap-storage": "tsx apps/cli/src/index.ts bootstrap-storage",
    "bundle-registry": "tsx apps/cli/src/index.ts bundle-registry",
    "bundle-pin": "tsx apps/cli/src/index.ts bundle-pin",
    "bundle-lifecycle-plan": "tsx apps/cli/src/index.ts bundle-lifecycle-plan",
    "bundle-manifest": "tsx apps/cli/src/index.ts bundle-manifest",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "exec-command": "tsx apps/cli/src/index.ts exec-command",
    "export-run": "tsx apps/cli/src/index.ts export-run",
    "index-project": "tsx apps/cli/src/index.ts index-project",
    "init-project": "tsx apps/cli/src/index.ts init-project",
    "ide-onboard": "tsx apps/cli/src/index.ts ide-onboard",
    "learning:daemon": "tsx apps/cli/src/index.ts learning-daemon",
    "apply-local-llm-routing-note-plan": "tsx apps/cli/src/index.ts apply-local-llm-routing-note-plan",
    "local-llm-benchmarks": "tsx apps/cli/src/index.ts local-llm-benchmarks",
    "local-llm-cache-trends": "tsx apps/cli/src/index.ts local-llm-cache-trends",
    "local-llm-checklist": "tsx apps/cli/src/index.ts local-llm-checklist",
    "local-llm-cost-ledger": "tsx apps/cli/src/index.ts local-llm-cost-ledger",
    "local-llm-download-recommendations": "tsx apps/cli/src/index.ts local-llm-download-recommendations",
    "local-llm-install-plan": "tsx apps/cli/src/index.ts local-llm-install-plan",
    "local-llm-inventory": "tsx apps/cli/src/index.ts local-llm-inventory",
    "local-llm-prune-plan": "tsx apps/cli/src/index.ts local-llm-prune-plan",
    "local-llm-routing-note-plan": "tsx apps/cli/src/index.ts local-llm-routing-note-plan",
    "local-llm-routing-recommendations": "tsx apps/cli/src/index.ts local-llm-routing-recommendations",
    "local-llm-setup-guide": "tsx apps/cli/src/index.ts local-llm-setup-guide",
    "local-llm-smoke": "tsx apps/cli/src/index.ts local-llm-smoke",
    "local-holdout-comparison": "tsx apps/cli/src/index.ts local-holdout-comparison",
    "local-holdout-promote": "tsx apps/cli/src/index.ts local-holdout-promote",
    "local-holdout-results": "tsx apps/cli/src/index.ts local-holdout-results",
    "migrate-storage": "tsx apps/cli/src/index.ts migrate-storage",
    "onboard-project": "tsx apps/cli/src/index.ts onboard-project",
    "validate": "tsx apps/cli/src/index.ts validate",
    "validate-examples": "node scripts/validate-scrubbed-examples.mjs",
    "list": "tsx apps/cli/src/index.ts list",
    "mcp": "tsx apps/mcp/src/index.ts",
    "object-artifact-proof": "tsx apps/cli/src/index.ts object-artifact-proof",
    "offline-fallback": "tsx apps/cli/src/index.ts offline-fallback",
    "offline-sync": "tsx apps/cli/src/index.ts offline-sync",
    "provider-check": "tsx apps/cli/src/index.ts provider-check",
    "provider-smoke": "bash scripts/provider-smoke.sh",
    "project-files": "tsx apps/cli/src/index.ts project-files",
    "reset-storage": "tsx apps/cli/src/index.ts reset-storage --yes",
    "restore-drill": "tsx apps/cli/src/index.ts restore-drill",
    "roadmap-audit": "tsx apps/cli/src/index.ts roadmap-audit",
    "runtime-monitor": "tsx apps/cli/src/index.ts runtime-monitor",
    "storage-migrate": "tsx apps/cli/src/index.ts storage-migrate",
    "storage-merge-evidence": "tsx apps/cli/src/index.ts storage-merge-evidence",
    "storage-merge-import": "tsx apps/cli/src/index.ts storage-merge-import",
    "storage-merge-manifest": "tsx apps/cli/src/index.ts storage-merge-manifest",
    "storage-verify": "tsx apps/cli/src/index.ts storage-verify",
    "status": "tsx apps/cli/src/index.ts status",
    "test": "node --import tsx --test 'packages/**/*.test.ts'",
    "smoke": "bash scripts/smoke-enterprise.sh",
    "services:reset": "docker compose -f infra/docker-compose.yml down -v",
    "server-readiness": "tsx apps/cli/src/index.ts server-readiness",
    "server-approval-action": "tsx apps/cli/src/index.ts server-approval-action",
    "server-approval-action-plan": "tsx apps/cli/src/index.ts server-approval-action-plan",
    "server-approval-action-test-adapter": "tsx apps/cli/src/index.ts server-approval-action-test-adapter",
    "server-mutation-controls": "tsx apps/cli/src/index.ts server-mutation-controls",
    "server-projects": "tsx apps/cli/src/index.ts server-projects",
    "server-resolve-project": "tsx apps/cli/src/index.ts server-resolve-project",
    "server-request-preview": "tsx apps/cli/src/index.ts server-request-preview",
    "server-route-preview": "tsx apps/cli/src/index.ts server-route-preview",
    "server-approval-preview": "tsx apps/cli/src/index.ts server-approval-preview",
    "worker": "tsx apps/cli/src/index.ts worker",
    "worker:daemon": "tsx apps/cli/src/index.ts worker --watch --limit 6 --interval-ms 2000",
    "worker:watch": "tsx apps/cli/src/index.ts worker --watch --limit 1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1098.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1098.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.2",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
