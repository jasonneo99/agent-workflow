{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonneo99.github.io/agent-workflow/schemas/project.schema.json",
  "title": "Agent Workflow Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "default": "" },
        "default_workflows": { "type": "array", "items": { "type": "string" }, "default": [] },
        "autonomy": { "$ref": "#/$defs/autonomy" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" }, "default": [] },
        "exclude": { "type": "array", "items": { "type": "string" }, "default": ["node_modules/**", ".git/**", "dist/**"] },
        "max_project_tokens": { "type": "integer", "minimum": 1, "default": 12000 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache_summaries": { "type": "boolean", "default": true },
        "semantic_index": { "type": "boolean", "default": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_profile": { "type": "string", "minLength": 1, "default": "local" },
        "policy_profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/executionPolicyProfile" },
          "default": {}
        },
        "worker_pool": { "$ref": "#/$defs/workerPool" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_wide_open": { "type": "boolean", "default": false },
        "require_approval_for_external_actions": { "type": "boolean", "default": true },
        "require_receipts": { "type": "boolean", "default": true }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_actor_role": { "type": "string", "minLength": 1, "default": "operator" },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/teamRole" },
          "default": {}
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_commands": { "type": "array", "items": { "type": "string" }, "default": ["npm test", "npm run typecheck", "npm run lint"] },
        "blocked_commands": { "type": "array", "items": { "type": "string" }, "default": ["rm *", "git reset *", "git clean *", "sudo *"] },
        "command_timeout_ms": { "type": "integer", "minimum": 1, "default": 120000 },
        "max_output_chars": { "type": "integer", "minimum": 1, "default": 20000 },
        "allowed_write_paths": { "type": "array", "items": { "type": "string" }, "default": [".agent-workflow/**", "docs/**"] },
        "blocked_write_paths": { "type": "array", "items": { "type": "string" }, "default": [".git/**", "node_modules/**", ".env", ".env.*"] },
        "max_write_bytes": { "type": "integer", "minimum": 1, "default": 200000 },
        "approval_rules": { "type": "array", "items": { "$ref": "#/$defs/approvalRule" }, "default": [] }
      }
    }
  },
  "$defs": {
    "autonomy": { "enum": [0, 1, 2, 3, 4, 5, "wide-open"], "default": 2 },
    "executionPolicyProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autonomy": { "$ref": "#/$defs/autonomy" },
        "policies": { "$ref": "#/$defs/policyOverrides" },
        "actions": { "$ref": "#/$defs/actionOverrides" }
      }
    },
    "workerPool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 6 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
        "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 900 },
        "interval_ms": { "type": "integer", "minimum": 250, "default": 2000 },
        "project_scoped": { "type": "boolean", "default": true },
        "default_profile": { "type": "string", "minLength": 1, "default": "local" },
        "profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/workerPoolProfile" },
          "default": {}
        }
      }
    },
    "workerPoolProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "default": "" },
        "worker_id": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "interval_ms": { "type": "integer", "minimum": 250 },
        "project_scoped": { "type": "boolean" },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "default": [{ "id": "default" }],
          "items": { "$ref": "#/$defs/workerPoolLane" }
        }
      }
    },
    "workerPoolLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "interval_ms": { "type": "integer", "minimum": 250 },
        "project_scoped": { "type": "boolean" }
      }
    },
    "policyOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_wide_open": { "type": "boolean" },
        "require_approval_for_external_actions": { "type": "boolean" },
        "require_receipts": { "type": "boolean" }
      }
    },
    "actionOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_commands": { "type": "array", "items": { "type": "string" } },
        "blocked_commands": { "type": "array", "items": { "type": "string" } },
        "command_timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_chars": { "type": "integer", "minimum": 1 },
        "allowed_write_paths": { "type": "array", "items": { "type": "string" } },
        "blocked_write_paths": { "type": "array", "items": { "type": "string" } },
        "max_write_bytes": { "type": "integer", "minimum": 1 },
        "approval_rules": { "type": "array", "items": { "$ref": "#/$defs/approvalRule" } }
      }
    },
    "teamRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "default": "" },
        "can_request_approvals": { "type": "boolean", "default": false },
        "can_approve_actions": { "type": "boolean", "default": false },
        "can_reject_actions": { "type": "boolean", "default": false },
        "can_execute_approved_actions": { "type": "boolean", "default": false },
        "can_author_workflows": { "type": "boolean", "default": false },
        "read_only": { "type": "boolean", "default": false }
      }
    },
    "approvalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action_type", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "default": "" },
        "action_type": { "enum": ["local_command", "file_write"] },
        "target": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["auto_execute"], "default": "auto_execute" },
        "max_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
